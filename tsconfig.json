{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",

    /* ------------- strict type checking ------------- */
    "strict": true,

    /* ------------- modulos y compilacion ------------- */

    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",

    "paths": {
      /* -------------  carpeta contenedora de codigo fuente ------------- */
      "@/*": ["./src/*"],

      /* ------------- spartan-ng  ------------- */

      /* helpers globales de spartan ng */
      "@spartan-ng/hlm-helper": ["./src/shared/design/ui/spartan-ng/helpers/hlm.helper.ts"],
      "@spartan-ng/provide-spartan-hlm-helper": [
        "./src/shared/design/ui/spartan-ng/helpers/provide-spartan-hlm.helper.ts"
      ],

      /* data-display/carousel */
      "@spartan-ng/carousel": ["./src/shared/design/ui/spartan-ng/data-display/carousel/index.ts"],

      /* data-display/data-table */
      "@spartan-ng/data-table": [
        "./src/shared/design/ui/spartan-ng/data-display/data-table/index.ts"
      ],

      /* form/date */
      "@spartan-ng/brn-luxon-date-adapter-normalized": [
        "./src/shared/design/ui/spartan-ng/form/date/brn-luxon-date-adapter-normalized.ts"
      ],

      /* form/action/button */
      "@spartan-ng/button": ["./src/shared/design/ui/spartan-ng/form/action/button/index.ts"],
      "@spartan-ng/hlm-button-const": [
        "./src/shared/design/ui/spartan-ng/form/action/button/data-types/constants/hlm-button.const.ts"
      ],
      "@spartan-ng/hlm-button-interface": [
        "./src/shared/design/ui/spartan-ng/form/action/button/data-types/interfaces/hlm-button.interface.ts"
      ],
      "@spartan-ng/hlm-button-type": [
        "./src/shared/design/ui/spartan-ng/form/action/button/data-types/types/hlm-button.type.ts"
      ],
      "@spartan-ng/hlm-button-helper": [
        "./src/shared/design/ui/spartan-ng/form/action/button/helpers/hlm-button.helper.ts"
      ],

      /* form/date/calendar */
      "@spartan-ng/calendar": ["./src/shared/design/ui/spartan-ng/form/date/calendar/index.ts"],

      /* form/date/date-picker */
      "@spartan-ng/date-picker": [
        "./src/shared/design/ui/spartan-ng/form/date/date-picker/index.ts"
      ],
      "@spartan-ng/hlm-date-picker-const": [
        "./src/shared/design/ui/spartan-ng/form/date/date-picker/data-types/constants/hlm-date-picker.const.ts"
      ],
      "@spartan-ng/hlm-date-picker-interface": [
        "./src/shared/design/ui/spartan-ng/form/date/date-picker/data-types/interfaces/hlm-date-picker.interface.ts"
      ],
      "@spartan-ng/hlm-date-picker-helper": [
        "./src/shared/design/ui/spartan-ng/form/date/date-picker/helpers/hlm-date-picker.helper.ts"
      ],

      /* form/selection/checkbox */
      "@spartan-ng/checkbox": [
        "./src/shared/design/ui/spartan-ng/form/selection/checkbox/index.ts"
      ],

      /* form/selection/combobox */
      "@spartan-ng/combobox": [
        "./src/shared/design/ui/spartan-ng/form/selection/combobox/index.ts"
      ],

      /* form/selection/radio-group */
      "@spartan-ng/radio-group": [
        "./src/shared/design/ui/spartan-ng/form/selection/radio-group/index.ts"
      ],

      /* form/selection/select */
      "@spartan-ng/select": ["./src/shared/design/ui/spartan-ng/form/selection/select/index.ts"],

      /* form/selection/switch */
      "@spartan-ng/switch": ["./src/shared/design/ui/spartan-ng/form/selection/switch/index.ts"],

      /* form/text/input/input-base */
      "@spartan-ng/input-base": [
        "./src/shared/design/ui/spartan-ng/form/text/input/input-base/index.ts"
      ],

      /* form/text/input/input-text */
      "@spartan-ng/input-text": [
        "./src/shared/design/ui/spartan-ng/form/text/input/input-text/index.ts"
      ],

      /* form/text/input/input-number */
      "@spartan-ng/input-number": [
        "./src/shared/design/ui/spartan-ng/form/text/input/input-number/index.ts"
      ],

      /* form/text/input/input-password */
      "@spartan-ng/input-password": [
        "./src/shared/design/ui/spartan-ng/form/text/input/input-password/index.ts"
      ],

      /* form/text/input/input-email */
      "@spartan-ng/input-email": [
        "./src/shared/design/ui/spartan-ng/form/text/input/input-email/index.ts"
      ],

      /* form/text/input/input-group */
      "@spartan-ng/input-group": [
        "./src/shared/design/ui/spartan-ng/form/text/input/input-group/index.ts"
      ],

      /* form/text/label */
      "@spartan-ng/label": ["./src/shared/design/ui/spartan-ng/form/text/label/index.ts"],

      /* form/text/textarea */
      "@spartan-ng/textarea": ["./src/shared/design/ui/spartan-ng/form/text/textarea/index.ts"],

      /* navigation/accordion */
      "@spartan-ng/accordion": ["./src/shared/design/ui/spartan-ng/navigation/accordion/index.ts"],

      /* navigation/pagination */
      "@spartan-ng/pagination": [
        "./src/shared/design/ui/spartan-ng/navigation/pagination/index.ts"
      ],
      "@spartan-ng/hlm-pagination-helper": [
        "./src/shared/design/ui/spartan-ng/navigation/pagination/helpers/hlm-pagination.helper.ts"
      ],

      /* navigation/tabs */
      "@spartan-ng/tabs": ["./src/shared/design/ui/spartan-ng/navigation/tabs/index.ts"],
      "@spartan-ng/hlm-tabs-const": [
        "./src/shared/design/ui/spartan-ng/navigation/tabs/data-types/constants/hlm-tabs.const.ts"
      ],

      /* overlay/alert-dialog */
      "@spartan-ng/alert-dialog": [
        "./src/shared/design/ui/spartan-ng/overlay/alert-dialog/index.ts"
      ],

      /* overlay/dialog */
      "@spartan-ng/dialog": ["./src/shared/design/ui/spartan-ng/overlay/dialog/index.ts"],
      "@spartan-ng/hlm-dialog-const": [
        "./src/shared/design/ui/spartan-ng/overlay/dialog/data-types/constants/hlm-dialog.const.ts"
      ],
      "@spartan-ng/hlm-dialog-type": [
        "./src/shared/design/ui/spartan-ng/overlay/dialog/data-types/types/hlm-dialog.type.ts"
      ],
      "@spartan-ng/hlm-dialog-service": [
        "./src/shared/design/ui/spartan-ng/overlay/dialog/services/hlm-dialog.service.ts"
      ],

      /* overlay/drawer */
      "@spartan-ng/drawer": ["./src/shared/design/ui/spartan-ng/overlay/drawer/index.ts"],

      /* overlay/dropdown-menu */
      "@spartan-ng/dropdown-menu": [
        "./src/shared/design/ui/spartan-ng/overlay/dropdown-menu/index.ts"
      ],
      "@spartan-ng/hlm-dropdown-menu-interface": [
        "./src/shared/design/ui/spartan-ng/overlay/dropdown-menu/data-types/interfaces/hlm-dropdown-menu.interface.ts"
      ],
      "@spartan-ng/hlm-dropdown-menu-helper": [
        "./src/shared/design/ui/spartan-ng/overlay/dropdown-menu/helpers/hlm-dropdown-menu.helper.ts"
      ],

      /* overlay/popover */
      "@spartan-ng/popover": ["./src/shared/design/ui/spartan-ng/overlay/popover/index.ts"],

      /* overlay/sheet */
      "@spartan-ng/sheet": ["./src/shared/design/ui/spartan-ng/overlay/sheet/index.ts"],

      /* overlay/toast */
      "@spartan-ng/toast": ["./src/shared/design/ui/spartan-ng/overlay/toast/index.ts"],

      /* overlay/tooltip */
      "@spartan-ng/tooltip": ["./src/shared/design/ui/spartan-ng/overlay/tooltip/index.ts"],
      "@spartan-ng/hlm-tooltip-const": [
        "./src/shared/design/ui/spartan-ng/overlay/tooltip/data-types/constants/hlm-tooltip.const.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,

    /* ------------- strict type checking de Angular ------------- */

    "strictTemplates": true,
    "strictStandalone": true,

    "extendedDiagnostics": {
      "defaultCategory": "error"
    }
  }
}
